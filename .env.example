# 复制为 .env 并修改(不要提交 .env 到 git)

# MySQL root 密码(首次启动生效)
# ⚠️ 重要:若已经部署过一次,再改这个密码不会生效(数据卷里存的是旧密码)。
#    要换密码必须: docker compose down -v  (会清空数据库数据) 后重新 up;
#    或登录旧 MySQL 里 ALTER USER 改密码。
MYSQL_PASSWORD=请改成强密码

# JWT 密钥,至少 32 位随机字符串
JWT_SECRET=请改成至少32位的随机字符串

# 宿主机端口映射(可选,默认值即可)
# 若宿主机 80 已被 nginx 占用,改 FRONTEND_PORT 为 8081 等
FRONTEND_PORT=80
# 若宿主机 8080 已被占用,改 BACKEND_PORT
BACKEND_PORT=8080
